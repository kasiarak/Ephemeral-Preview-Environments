<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview environment ${env_name}</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font: 16px/1.5 system-ui, sans-serif;
        color: #1c2024;
        background: #f6f8fa;
      }
      main {
        padding: 2.5rem;
        border: 1px solid #d8dee4;
        border-radius: 8px;
        background: #fff;
      }
      h1 {
        margin: 0 0 1.5rem;
        font-size: 1.25rem;
      }
      dl {
        display: grid;
        grid-template-columns: auto auto;
        gap: 0.5rem 2rem;
        margin: 0 0 1.5rem;
      }
      dt {
        color: #59636e;
      }
      dd {
        margin: 0;
        font-weight: 600;
      }
      code {
        font-family: ui-monospace, monospace;
      }
      a {
        color: #0969da;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Preview environment</h1>
      <dl>
        <dt>Environment</dt>
        <dd>${env_name}</dd>
        <dt>Pull request</dt>
        <dd>#${pr_number}</dd>
        <dt>Commit</dt>
        <dd><code>${commit_sha}</code></dd>
      </dl>
      <p>
        <a href="${api_url}/health">/health</a>
        &middot;
        <a href="${api_url}/info">/info</a>
      </p>
    </main>
  </body>
</html>
