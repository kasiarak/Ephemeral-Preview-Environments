# Local overrides, read by both `make` and `docker compose`.
# Copy to .env (gitignored) and adjust. Plain KEY=value only - no quotes, no
# spaces around "=", because the Makefile includes this file directly.

# Host port for LocalStack. Change it when another LocalStack instance already
# holds the default 4566, e.g. a Pro container used by another project.
LOCALSTACK_PORT=4566

# Set to 1 for verbose LocalStack logs.
DEBUG=0
